    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7c797b95-dd0b-42c0-87ae-acb4d40d3082</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
